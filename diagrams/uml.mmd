classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list pets
        +add_pet(pet)
        +get_pets()
        +get_all_tasks()
    }

    class Pet {
        +str name
        +str species
        +list tasks
        +add_task(task)
        +remove_task(task_title)
        +get_tasks()
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str time
        +str frequency
        +bool completed
        +mark_complete()
        +mark_incomplete()
        +is_recurring()
        +summary()
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks()
        +sort_tasks_by_time()
        +sort_tasks_by_priority()
        +filter_tasks_by_pet(pet_name)
        +filter_tasks_by_status(completed)
        +generate_daily_plan(available_minutes)
        +detect_conflicts()
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Scheduler "1" --> "1" Owner : schedules for